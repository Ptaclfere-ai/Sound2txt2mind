DEEPSEEK_API_KEY=替换成你的DeepSeekKey

# Whisper 推理参数（可按机器性能调整）
WHISPER_MODEL=base               # 可改 small / medium / large-v3
WHISPER_DEVICE=cpu               # 若是V100/A10等GPU可用 'cuda'
WHISPER_COMPUTE_TYPE=int8        # 可改 int8_float32 / float32（更准更慢）

# 容器内 ffmpeg 地址（Dockerfile 已安装）
FFMPEG_BIN=/usr/bin/ffmpeg
